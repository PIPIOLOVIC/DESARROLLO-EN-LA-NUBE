# Puerto de la aplicación
PORT=3000

# Base de datos PostgreSQL
# Para ejecución local usar DB_HOST=localhost; dentro de Docker Compose se configura automáticamente a postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password123
DB_NAME=aguafix_db

# Configuración de Correo / Nodemailer
# Opción 1 (Recomendada para pruebas y desarrollo): Mailtrap (https://mailtrap.io)
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USER=tu_usuario_mailtrap
# MAIL_PASS=tu_password_mailtrap

# Opción 2: Gmail con App Password (requiere verificación en 2 pasos activada)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_app_password

# Remitente y destinatario de alertas
MAIL_FROM="AguaFix Alertas <no-reply@aguafix.com>"
MAINTENANCE_EMAIL=cuadrilla_mantenimiento@municipio.gob

# AWS S3
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=tu_nombre_de_bucket